[Unit]
Description=SBR3 ground-station bridge (Teensy <-> web UI)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@REPO@
ExecStart=/usr/bin/python3 -m station.bridge --port /dev/ttyACM0 --http-port 80 --log-dir @HOME@/sbr3-logs
Environment=PYTHONUNBUFFERED=1
# port 80 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
Nice=-5
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target