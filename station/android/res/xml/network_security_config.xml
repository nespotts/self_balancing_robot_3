<?xml version="1.0" encoding="utf-8"?>
<!--
  The bridge is plain http on the LAN. Android's config can only list exact hosts, not IP ranges, and the robot's
  address comes from a subnet scan, so cleartext is allowed here and limited in code instead:
    - the WebView only loads private-LAN hosts; names must resolve private and stay pinned (HostPolicy)
    - every other request from the page is answered 403, frames / sub-resources only from the page's own origin
      (MainActivity.shouldInterceptRequest)
    - the finder only probes private IPv4 addresses (Lan.scanList / Finder.probe)
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>