Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Tree Height: 500
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Alpha: 0.3
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Color Scheme: map
      Alpha: 0.8
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 1
      Color Scheme: costmap
      Alpha: 0.4
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 1
      Color Scheme: costmap
      Alpha: 0.5
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LD19 scan
      Enabled: true
      Topic:
        Value: /scan
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Depth: 5
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.5
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
      Keep: 50
      Position Tolerance: 0.05
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 50; 120; 255
        Alpha: 1
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.03
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Global plan
      Enabled: true
      Topic:
        Value: /plan
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
      Color: 25; 255; 0
      Line Style: Lines
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Local plan
      Enabled: true
      Topic:
        Value: /local_plan
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
      Color: 255; 170; 0
      Line Style: Lines
      Value: true
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
      Color: 0; 200; 255
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Keep-out zones
      Enabled: true
      Topic:
        Value: /keepout_filter_mask
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Color Scheme: costmap
      Alpha: 0.35
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Station places + zones
      Enabled: true
      Topic:
        Value: /station/markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 150
      X: 1.5
      Y: 0.25
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Width: 1400
  Height: 900
  Displays:
    collapsed: false
